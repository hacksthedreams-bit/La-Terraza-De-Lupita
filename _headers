# Cloudflare Pages — equivalente al .htaccess (Apache), que Cloudflare ignora.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests

# Código: se revalida en cada visita (el ?v= de index.html fuerza el cambio)
/index.html
  Cache-Control: no-cache, must-revalidate
/css/*
  Cache-Control: no-cache, must-revalidate
/js/*
  Cache-Control: no-cache, must-revalidate

# Fotos de platos y portada: 1 hora (si se reemplaza una foto, se ve el cambio en menos de 1 h).
# Las reglas NO deben solaparse: Cloudflare une los valores si dos reglas coinciden con una ruta.
/assets/img/*
  Cache-Control: public, max-age=3600, must-revalidate

# Adornos, marcos, marca e íconos (casi nunca cambian): 30 días
/assets/bebidas/*
  Cache-Control: public, max-age=2592000
/assets/brand/*
  Cache-Control: public, max-age=2592000
/assets/decor/*
  Cache-Control: public, max-age=2592000
/assets/horarios/*
  Cache-Control: public, max-age=2592000
/assets/icons/*
  Cache-Control: public, max-age=2592000
/assets/lupita-aprobados/*
  Cache-Control: public, max-age=2592000
/assets/lupita-sandwiches-aprobado/*
  Cache-Control: public, max-age=2592000
/assets/menu/*
  Cache-Control: public, max-age=2592000
/assets/veganos/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon-32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
