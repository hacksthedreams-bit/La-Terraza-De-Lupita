{
  "name": "Asistente WhatsApp - La Terraza de Lupita",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "1a2b3c4d-0001-4a1a-9c1a-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [-1200, 0],
      "webhookId": "whatsapp-lupita",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "1",
          "name": "WhatsApp Cloud - La Terraza de Lupita"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.messages[0].type }}",
              "rightValue": "text",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a2b3c4d-0002-4a1a-9c1a-000000000002",
      "name": "Solo mensajes de texto",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [-980, 0]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst texto = msg.messages[0].text.body;\nconst telefono = msg.messages[0].from;\nreturn [{ json: { texto, texto_normalizado: texto.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, ''), telefono } }];"
      },
      "id": "1a2b3c4d-0003-4a1a-9c1a-000000000003",
      "name": "Normalizar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-760, 0]
    },
    {
      "parameters": {
        "jsCode": "// Carga las FAQs (edítalas en whatsapp-assistant/knowledge/faqs.json y pega el contenido aquí,\n// o reemplaza este nodo por un nodo \"Read Binary File\" / Google Sheets si prefieres editarlas sin tocar el workflow).\nconst faqs = $getWorkflowStaticData('global').faqs || [];\nconst texto = $input.first().json.texto_normalizado;\n\nlet mejor = null;\nlet mejorScore = 0;\nfor (const faq of faqs) {\n  let score = 0;\n  for (const kw of faq.keywords) {\n    if (texto.includes(kw.toLowerCase())) score++;\n  }\n  if (score > mejorScore) {\n    mejorScore = score;\n    mejor = faq;\n  }\n}\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    coincidencia: mejor ? mejor.respuesta : null,\n    faq_id: mejor ? mejor.id : null\n  }\n}];"
      },
      "id": "1a2b3c4d-0004-4a1a-9c1a-000000000004",
      "name": "Buscar en FAQs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.coincidencia }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "1a2b3c4d-0005-4a1a-9c1a-000000000005",
      "name": "¿Hay coincidencia en FAQs?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "respuesta_final", "value": "={{ $json.coincidencia }}", "type": "string" }
          ]
        }
      },
      "id": "1a2b3c4d-0006-4a1a-9c1a-000000000006",
      "name": "Respuesta directa (gratis)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [-100, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-haiku-4-5-20251001\",\n  max_tokens: 300,\n  system: \"Eres el asistente de WhatsApp de \" + $json.negocio.nombre + \". Responde SIEMPRE en español, tono: \" + $json.negocio.tono + \". Reglas: \" + $json.negocio.reglas.join(' | ') + \". Datos del negocio: \" + JSON.stringify($json.negocio) + \". Si no sabes algo con certeza, di que un miembro del equipo lo confirmará, nunca inventes precios o platos.\",\n  messages: [ { role: \"user\", content: $json.texto } ]\n}) }}"
      },
      "id": "1a2b3c4d-0007-4a1a-9c1a-000000000007",
      "name": "IA (respaldo, modelo económico)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-100, 140],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "respuesta_final", "value": "={{ $json.content[0].text }}", "type": "string" }
          ]
        }
      },
      "id": "1a2b3c4d-0008-4a1a-9c1a-000000000008",
      "name": "Extraer respuesta IA",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [100, 140]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $('Normalizar mensaje').item.json.telefono }}",
        "textBody": "={{ $json.respuesta_final }}"
      },
      "id": "1a2b3c4d-0009-4a1a-9c1a-000000000009",
      "name": "Enviar respuesta WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [340, 0],
      "credentials": {
        "whatsAppApi": {
          "id": "1",
          "name": "WhatsApp Cloud - La Terraza de Lupita"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": { "main": [[{ "node": "Solo mensajes de texto", "type": "main", "index": 0 }]] },
    "Solo mensajes de texto": { "main": [[{ "node": "Normalizar mensaje", "type": "main", "index": 0 }]] },
    "Normalizar mensaje": { "main": [[{ "node": "Buscar en FAQs", "type": "main", "index": 0 }]] },
    "Buscar en FAQs": { "main": [[{ "node": "¿Hay coincidencia en FAQs?", "type": "main", "index": 0 }]] },
    "¿Hay coincidencia en FAQs?": {
      "main": [
        [{ "node": "Respuesta directa (gratis)", "type": "main", "index": 0 }],
        [{ "node": "IA (respaldo, modelo económico)", "type": "main", "index": 0 }]
      ]
    },
    "IA (respaldo, modelo económico)": { "main": [[{ "node": "Extraer respuesta IA", "type": "main", "index": 0 }]] },
    "Respuesta directa (gratis)": { "main": [[{ "node": "Enviar respuesta WhatsApp", "type": "main", "index": 0 }]] },
    "Extraer respuesta IA": { "main": [[{ "node": "Enviar respuesta WhatsApp", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
